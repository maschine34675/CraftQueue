<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Version>2.4.3</Version>
    <AssemblyVersion>2.4.3</AssemblyVersion>
    <FileVersion>2.4.3</FileVersion>
    <Company>https://github.com/maschine34675/CraftQueue</Company>
    <Authors>maschine</Authors>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>maschine-CraftQueue.Server</AssemblyName>
    <OutputType>Library</OutputType>
    <SPTModType>Server</SPTModType>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Configurations>Debug;Release</Configurations>
    <Nullable>enable</Nullable>
    <DeployToSpt Condition="'$(DeployToSpt)' == ''">true</DeployToSpt>
    <!-- Relativ zur Arbeitskopie: <Install>\Development\CraftQueue\<Teil>\ -> <Install>.
         Ueberschreibbar mit /p:SptRoot=... -->
    <SptRoot Condition="'$(SptRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\</SptRoot>
    <OverwriteSptConfig Condition="'$(OverwriteSptConfig)' == ''">false</OverwriteSptConfig>
    <SptModName>CraftQueue</SptModName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\CraftQueue.Shared\CraftQueueProtocol.cs" Link="CraftQueueProtocol.cs" />
    <Content Update="config\config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SPTarkov.Common" Version="4.1.0" ExcludeAssets="runtime" />
    <PackageReference Include="SPTarkov.DI" Version="4.1.0" ExcludeAssets="runtime" />
    <PackageReference Include="SPTarkov.Reflection" Version="4.1.0" ExcludeAssets="runtime" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.1.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <Target Name="DeployToSpt" AfterTargets="Build" Condition="'$(DeployToSpt)' == 'true'">
    <Error Condition="'$(SptRoot)' == ''" Text="Set SptRoot when DeployToSpt=true." />
    <!-- A SptRoot that lost its backslash on the way in (bash turns
         -p:SptRoot=D:\SPT41 into D:SPT41) stays drive-relative and resolves
         INSIDE this repository, quietly spraying build output into the source
         tree - it happened twice. Refuse anything that is not a real game
         root instead of trusting the path. -->
    <Error Condition="!Exists('$(SptRoot)\EscapeFromTarkov.exe')"
           Text="SptRoot '$(SptRoot)' is not an SPT installation (no EscapeFromTarkov.exe). A relative or mistyped path would deploy into the repository; pass an absolute path or omit SptRoot to use the default." />
    <PropertyGroup>
      <ServerModDirectory>$(SptRoot)\SPT_Runtime\user\mods\$(SptModName)</ServerModDirectory>
    </PropertyGroup>
    <MakeDir Directories="$(ServerModDirectory)\config" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ServerModDirectory)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ServerModDirectory)" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    <Copy SourceFiles="config\config.json"
          DestinationFolder="$(ServerModDirectory)\config"
          SkipUnchangedFiles="true"
          Condition="'$(OverwriteSptConfig)' == 'true' Or !Exists('$(ServerModDirectory)\config\config.json')" />
  </Target>

</Project>
